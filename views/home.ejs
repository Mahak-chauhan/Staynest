<% layout("layouts/boilerplate") %>

<div class="container">

    <!-- Hero Section -->
    <section class="hero-section text-center">

        <h1 class="display-3 fw-bold">
            🏡 StayNest
        </h1>

        <h3 class="mt-3 text-primary">
            Discover. Book. Stay.
        </h3>

        <p class="lead mt-4 hero-text">
            Find beautiful vacation homes, apartments, villas,
            and unique stays across India.
        </p>

        <a href="/listings" class="btn btn-primary btn-lg hero-btn mt-4">
            Explore Listings
        </a>

    </section>

    <!-- Popular Destinations -->

    <section class="my-5">

        <h2 class="text-center fw-bold mb-5">
            🌍 Popular Destinations
        </h2>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="card destination-card">

                    <img
                        src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=800"
                        class="card-img-top"
                        alt="Goa"
                    >

                    <div class="card-body text-center">
                        <h5 class="fw-bold">🌴 Goa</h5>
                    </div>

                </div>
            </div>

            <div class="col-md-3">
                <div class="card destination-card">

                    <img
                        src="https://images.unsplash.com/photo-1597074866923-dc0589150358?w=800"
                        class="card-img-top"
                        alt="Manali"
                    >

                    <div class="card-body text-center">
                        <h5 class="fw-bold">🏔️ Manali</h5>
                    </div>

                </div>
            </div>

            <div class="col-md-3">
                <div class="card destination-card">

                    <img
                        src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=800"
                        class="card-img-top"
                        alt="Jaipur"
                    >

                    <div class="card-body text-center">
                        <h5 class="fw-bold">🏰 Jaipur</h5>
                    </div>

                </div>
            </div>

            <div class="col-md-3">
                <div class="card destination-card">

                    <img
                        src="https://images.unsplash.com/photo-1593693397690-362cb9666fc2?w=800"
                        class="card-img-top"
                        alt="Kerala"
                    >

                    <div class="card-body text-center">
                        <h5 class="fw-bold">🏝️ Kerala</h5>
                    </div>

                </div>
            </div>

        </div>

    </section>

</div>